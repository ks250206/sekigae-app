{
  "title": "Rules",
  "description": "Combine blocks to build your seating rules.",
  "categories": {
    "room": "Room",
    "seat": "Seat",
    "person": "Person",
    "global": "Global",
    "logic": "Logic"
  },
  "blocks": {
    "room": {
      "only": {
        "name": "Room only for",
        "template": "Only <people/> in <rooms/>"
      },
      "prefer": {
        "name": "Prefer in room",
        "template": "Prefer <people/> in <rooms/>"
      },
      "count": {
        "name": "Head count",
        "template": "<people/> in <rooms/>: <op/> <value/>"
      },
      "exclude": {
        "name": "Keep out of room",
        "template": "Keep <people/> out of <rooms/>"
      },
      "diversity": {
        "name": "Mix",
        "template": "Mix at least <min/> different <attr/> in <rooms/>"
      },
      "attrCap": {
        "name": "Cap per group",
        "template": "In <rooms/>, at most <max/> people of the same <attr/>"
      }
    },
    "seat": {
      "only": {
        "name": "Seats only for",
        "template": "Only <people/> may sit at <seats/>"
      },
      "pin": {
        "name": "Pre-place",
        "template": "Pre-place <member/> at <seat/>"
      },
      "empty": {
        "name": "Leave empty",
        "template": "Leave <seats/> empty"
      }
    },
    "person": {
      "pin": {
        "name": "Pin",
        "template": "Pin <member/> to <target/>"
      },
      "avoid": {
        "name": "Avoid",
        "template": "Keep <member/> away from <seats/>"
      }
    },
    "pair": {
      "relation": {
        "name": "Pair relation",
        "template": "Seat <a/> and <b/> <relation/> <qualLab/> <qualRole/>"
      }
    },
    "prev": {
      "different": {
        "name": "Change from last year",
        "template": "<people/> get <scope/> than last year"
      },
      "same": {
        "name": "Keep last year's",
        "template": "<people/> keep <scope/> as last year"
      }
    },
    "group": {
      "cluster": {
        "name": "Cluster",
        "template": "Cluster <people/> by <attr/>"
      },
      "spread": {
        "name": "Spread",
        "template": "Spread <people/> across rooms by <attr/>"
      },
      "mixAdjacent": {
        "name": "Mix neighbors",
        "template": "Neighbors among <people/> have different <attr/>"
      },
      "buddy": {
        "name": "Buddy",
        "template": "Each of <a/> has at least <min/> <b/> from the same lab <scope/>"
      },
      "labBalance": {
        "name": "Lab balance",
        "template": "Balance each room's lab mix of <people/> to the overall ratio"
      }
    },
    "depth": {
      "order": {
        "name": "Depth order",
        "template": "Among <people/>, the more senior sits <direction/>"
      }
    },
    "logic": {
      "any": {
        "name": "Any of",
        "template": "At least one of the following"
      },
      "all": {
        "name": "All of",
        "template": "All of the following"
      },
      "ifThen": {
        "name": "If … then",
        "template": "If … then",
        "if": "If",
        "then": "then"
      }
    }
